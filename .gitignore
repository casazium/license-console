# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files. Blanket pattern (matches casazium/license's own .gitignore
# convention) rather than just .env*.local + .env - that narrower form
# would silently NOT ignore a stray .env.production or similar if anyone
# ever created one here out of habit from that repo's own naming.
.env*
!.env.example
!.env.selfhosted.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# test coverage output (vitest run --coverage)
/coverage/

# local dev database (SaaS-B1a, lib/db.ts - DB_FILE)
/data/
*.db
*.db-journal
*.db-wal
*.db-shm
