# License Console - self-hosted environment template.
#   cp .env.selfhosted.example .env
#
# This is a curated subset for the self-hosted quickstart
# (docker-compose.selfhosted.yml) - self-hosted mode is MULTI_TENANT
# left unset, so that var and every SaaS-only one it gates (accounts,
# billing, per-tenant branding) are deliberately not included here. For
# the full set of every variable this app reads, including optional
# branding and notification settings, see .env.example in this repo.

# --- Required ---

# Session signing secret (HMAC key for signed session cookies). Generate with:
#   openssl rand -base64 32
SESSION_SECRET=

# Shared admin login gating this console. Choose your own values - any
# non-empty username/password, compared to what you set here at login
# time.
ADMIN_UI_USERNAME=
ADMIN_UI_PASSWORD=

# The real, public origin this console is reachable at (e.g.
# https://console.example.com, no trailing slash, and NOT the
# 127.0.0.1 address docker-compose.selfhosted.yml binds to - that's
# only reachable from this host itself). Every emailed link and
# email-triggered redirect is built from this. Required in production;
# get a real reverse proxy with TLS in front of this container before
# setting it to anything but a local address.
PUBLIC_BASE_URL=

# --- Backend mode (pick one) ---
#
# Both LICENSE_API_URL/LICENSE_ADMIN_API_KEY set -> connects to your
# real, self-hosted License Server. Both left unset -> standalone mode:
# an in-memory mock with seeded demo data, no real backend required,
# for trying the console's look and feel on its own first. Setting only
# one is almost certainly a mistake and fails fast with a clear error.

# Base URL of your License Server, including the /v1 prefix (e.g.
# https://license.example.com/v1).
LICENSE_API_URL=

# Optional: the License Server's public origin (e.g.
# https://license.example.com), used only to build the customer-facing
# portal links this console shows after issuing a license. Leave unset
# when LICENSE_API_URL above is already publicly reachable; set it when
# this console reaches the server over a private address customers can't
# open (a Docker network name like http://license:3001/v1, a VPN IP).
LICENSE_PUBLIC_URL=

# Admin bearer token for that License Server - must match its own
# ADMIN_API_KEY exactly (a known asymmetric-trimming bug has bitten this
# exact pairing before - see PROJECT_STATUS.md §60 - so double-check for
# accidental leading/trailing whitespace if this rejects a key that
# looks right).
LICENSE_ADMIN_API_KEY=

# Alternatively, read that key from a file: set LICENSE_ADMIN_API_KEY_FILE
# to its path (the Docker-secrets convention) and leave the line above
# blank. A value set directly still wins; a file that's missing or empty
# stops the console at startup. casazium/license's self-hosted bundle uses
# this to share one generated key with License Server.
LICENSE_ADMIN_API_KEY_FILE=

# Required (set to "true") in production ONLY when the two vars above
# are both intentionally left unset - i.e. you're running this as a
# real standalone/demo instance rather than connecting to a license
# server. Not required for a quick local trial (leaving both unset with
# no .env at all already defaults to standalone mode).
LICENSE_STANDALONE_MODE=

# --- Optional (all have working defaults) ---

# Defaults to 3000. Change here AND in docker-compose.selfhosted.yml's
# ports: mapping if you need a different port.
PORT=
