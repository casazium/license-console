# Session signing secret (HMAC key for signed session cookies). Generate with:
#   openssl rand -base64 32
SESSION_SECRET=

# Shared admin login pair gating the console. Single username+password for
# now - see PROJECT_STATUS.md §9 for the planned migration path to real
# per-user accounts.
ADMIN_UI_USERNAME=
ADMIN_UI_PASSWORD=

# --- Branding (all optional; unset falls back to sane defaults) ---
#
# Coolify-specific gotcha (confirmed): Coolify's environment variables UI
# has a per-variable "Is Literal" checkbox. Leave it OFF and Coolify may
# reprocess/escape the value before injecting it (observed corrupting both
# BRANDING_TITLE_HTML's embedded HTML and BRANDING_COLOR's value - see the
# quoting note under BRANDING_COLOR below for one way that showed up as a
# bug). Enable "Is Literal" for BRANDING_TITLE_HTML and BRANDING_COLOR so
# Coolify passes them through unmodified. Other platforms' env-var UIs may
# have an equivalent toggle - check for one if branding doesn't apply.

# URL to a logo image - local (/branding/logo.png, served from public/) or
# remote (https://...). Shown at a small size in the app header and a larger
# size on the login page. Leave unset to show no logo.
BRANDING_LOGO_URL=

# HTML (or plain text - both render fine through the same path) shown as the
# app title on the login page only - the in-app header (AppShellClient.tsx)
# shows just the logo, not this. Defaults to "License Console" if unset.
# Operator-controlled config, rendered as raw markup -
# never source this from user input. If your logo has a fixed brand color,
# reference it with var(--brand-color) instead of hardcoding a hex here, e.g.:
#   <span style="color:var(--brand-color)">Acme</span> License Console
# That keeps the title's accent and the primary button (BRANDING_COLOR,
# below) the same color automatically, instead of typing the same hex twice
# and having them drift apart.
BRANDING_TITLE_HTML=

# A single accent color (any valid CSS color, e.g. a hex matching your logo)
# applied to the primary button and available to BRANDING_TITLE_HTML via
# var(--brand-color) - see the note above. Defaults to Mantine's standard
# blue (#228be6) if unset.
#
# If you're editing a .env FILE directly, quote hex values so dotenv doesn't
# parse the unquoted # as a comment, e.g. BRANDING_COLOR="#2563eb". If
# you're instead pasting this into a platform's env-var UI (Coolify, Docker,
# etc.), do NOT include the quotes - those UIs take the field value
# literally with no shell/dotenv-style stripping, so the quote characters
# would become part of the color itself and break rendering (confirmed:
# turns the primary button transparent). Enter #2563eb there, no quotes.
BRANDING_COLOR=

# Copyright holder name shown in a small "(c) <year> <holder>" line (year is
# computed automatically). Leave unset to hide the copyright line entirely.
BRANDING_COPYRIGHT_HOLDER=

# URL to a favicon image (local /favicon.png served from public/, or a
# remote https://... URL - same "no CORS issue, no next.config.js changes"
# reasoning as BRANDING_LOGO_URL applies here too). Leave unset to fall back
# to Next's own default favicon.
BRANDING_FAVICON_URL=

# --- Backend mode ---
#
# Both set -> connected to a real casazium/license server. Both left unset
# -> standalone mode: an in-memory mock with seeded demo data, no real
# backend required, for evaluating the console's look and feel on its own.
# Setting only one is almost certainly a mistake (e.g. a typo'd variable
# name) and fails fast with a clear error rather than guessing which mode
# was meant - see lib/license-client.ts's getBackendMode().

# Base URL of the casazium/license server this console manages, including
# the /v1 prefix (e.g. https://license.example.com/v1).
LICENSE_API_URL=

# Admin bearer token for the license server (casazium/license ADMIN_API_KEY).
# Server-side only - never expose via NEXT_PUBLIC_*.
LICENSE_ADMIN_API_KEY=

# Required (set to "true") in production ONLY when LICENSE_API_URL and
# LICENSE_ADMIN_API_KEY above are both intentionally left unset - i.e. you
# are deploying this as a real, public standalone/demo instance rather than
# connecting to an actual license server. In production, both-unset without
# this flag is treated as a misconfiguration (an operator who meant to
# configure live mode but didn't) rather than silently falling back to
# demo data - see lib/license-client.ts's getBackendMode(). Not required in
# development - `npm run dev` with no .env at all still defaults to
# standalone mode with zero config.
LICENSE_STANDALONE_MODE=
