# Path to this console's own SQLite database file (SaaS-B1a - accounts,
# sessions; separate from casazium/license's own DB, which stores tenant
# API credentials, not human login accounts). Optional; defaults to
# ./data/console.db (relative to the project root in dev, /app in the
# standalone/Docker runtime).
DB_FILE=

# Under MULTI_TENANT=true, DB_FILE must already exist - without this
# guard, a restart hitting a missing/detached volume silently created a
# fresh empty database and booted looking perfectly healthy while every
# account was gone (real incident, not hypothetical). Set DB_ALLOW_INIT=true
# ONLY as a one-time step for a genuine first launch of a MULTI_TENANT=true
# deployment (a brand-new SaaS resource, or a from-scratch disaster-recovery
# rebuild - see DEPLOYMENT.md's Backups section) - never leave it set on an
# already-initialized, long-running resource. Unused, and safe to leave
# unset, under self-hosted (MULTI_TENANT unset/false), which always
# auto-creates a missing file regardless of this variable.
DB_ALLOW_INIT=

# Session signing secret (HMAC key for signed session cookies). Generate with:
#   openssl rand -base64 32
SESSION_SECRET=

# The real, public origin this console is reachable at (e.g.
# https://console.example.com, no trailing slash). Required in production
# (lib/config.ts's publicBaseUrl() throws at request time if unset) -
# every emailed link (signup confirmation, password reset) and every
# email-triggered redirect is built from this, not from the request
# itself: Next pins a route handler's request.nextUrl.origin to the
# server's own configured HOSTNAME/PORT, which in the shipped Docker
# image is the unreachable http://0.0.0.0:3000 (security review finding
# H2) - not something a client can ever open. Not required in
# development - `npm run dev` falls back to the request's own origin,
# which happens to be correct there.
PUBLIC_BASE_URL=

# How many hops of X-Forwarded-For, counted from the right, were appended
# by your own trusted proxy chain (lib/login-rate-limit.ts's getClientIp -
# security review finding H1). Optional; defaults to 1, correct for every
# deployment this repo documents today (Coolify's Traefik is the sole
# path in - see docker-compose-coolify.yml's `expose:` rather than
# `ports:`). Only change this if you add another proxy hop in front of
# Traefik - a wrong value either lets clients spoof their way past
# rate-limiting (too high) or rate-limits everyone behind Traefik
# together (too low).
TRUSTED_PROXY_COUNT=

# Optional text rendered as a persistent, hard-to-miss banner across
# every page (components/EnvironmentBanner.tsx) - production/test
# confusion is a real failure mode (an admin acting against the wrong
# tenant because nothing on screen said which deployment they were in).
# Unset (the default) renders nothing at all - every existing deployment,
# production included, is unaffected unless you explicitly set this on a
# non-production resource, e.g.:
#   ENVIRONMENT_LABEL=TEST ENVIRONMENT
ENVIRONMENT_LABEL=

# SaaS tier feature flag (SaaS-B1b), mirroring casazium/license's own
# MULTI_TENANT var. Unset/false (the default, self-hosted): the console
# has exactly one operator, gated by ADMIN_UI_USERNAME/PASSWORD below -
# /signup doesn't exist (404s). true: gates on the accounts table
# instead, and self-service /signup becomes reachable - see lib/auth.ts.
MULTI_TENANT=

# Encryption key for accounts.tenant_api_key_encrypted (SaaS-B1b) - the
# plaintext per-tenant API key casazium/license's POST /admin/tenants
# returns exactly once at signup, encrypted at rest here. Required when
# MULTI_TENANT=true. 32 bytes, hex-encoded (64 hex characters), same
# format as casazium/license's own ENCRYPTION_KEY but a DIFFERENT value -
# do not reuse that repo's key here, these are two independently
# deployable services. Generate with:
#   openssl rand -hex 32
ACCOUNT_ENCRYPTION_KEY=

# Signup confirmation email provider. Optional; defaults to 'stub', which
# logs the confirmation link to the server console instead of sending a
# real email (see lib/email/). Set to 'resend' to actually send. Only
# meaningful under MULTI_TENANT=true; self-hosted has no accounts/signup
# concept at all. Any other value fails at the point of use, not at boot -
# mirrors casazium/license's own BILLING_PROVIDER posture.
EMAIL_PROVIDER=

# Required when EMAIL_PROVIDER=resend. From https://resend.com/api-keys.
RESEND_API_KEY=

# Required in production when EMAIL_PROVIDER=resend (createResendEmailProvider()
# throws otherwise, beta-readiness finding - see DEPLOYMENT.md). Defaults
# to Resend's own onboarding@resend.dev sender, which their API only
# delivers to the account's own verified email address (no domain
# verification needed to test with that default - good for exactly that:
# a quick real-send test in development, where this is genuinely
# optional). Once a real sending domain is verified on the Resend
# account, set this to a real from-address on that domain to send to
# anyone else - required before a real production signup/password-reset
# flow will actually reach real users.
EMAIL_FROM=

# Optional operator notifications (TASK_ACCOUNT_NOTIFICATIONS.md) - a
# Discord webhook fired on account.created/account.deleted/login/logout.
# Unset by default in every deployment mode, self-hosted included - this
# is genuinely opt-in, never required. Get a webhook URL from a Discord
# server you control: Server Settings -> Integrations -> Webhooks -> New
# Webhook. account.created/login/logout show the real account email (or,
# self-hosted, the configured ADMIN_UI_USERNAME below); account.deleted
# shows only the opaque account id, never an email - see
# TASK_ACCOUNT_NOTIFICATIONS.md's PII section for why (a plaintext email
# in a permanent Discord message would outlive this app's own
# "permanently deleted, cannot be recovered" promise for hosted accounts).
# No fail-loud-in-production check the way EMAIL_PROVIDER has one -
# unset must stay a quiet no-op forever, since nothing the product
# promises anyone depends on this working.
NOTIFY_WEBHOOK_URL=

# Shared admin login pair gating the console under self-hosted deployments
# (MULTI_TENANT unset/false) only - required in that mode, unused under
# MULTI_TENANT=true (see lib/auth.ts). See PROJECT_STATUS.md §9 for why
# this shape was chosen for self-hosted, and §30 for the SaaS-mode
# accounts table that replaces it there.
ADMIN_UI_USERNAME=
ADMIN_UI_PASSWORD=

# --- Branding (all optional; unset falls back to sane defaults) ---
#
# Under MULTI_TENANT=true (SaaS-B3), these vars are the *platform*
# default: shown on pre-auth pages (/login, /signup, where there's no
# tenant to look up yet) and to any logged-in tenant that hasn't
# overridden a given field in its own tenant_branding row. No settings
# UI writes that table yet - lib/branding.ts's DB-driven resolution is
# built and tested, but nothing currently lets a tenant set their own
# branding through the app itself.
#
# Coolify-specific gotcha (confirmed, and confirmed NOT fixed by "Is
# Literal"): Coolify has long-standing, upstream-unresolved bugs where any
# env var value containing a double-quote (") character gets mangled on
# injection, regardless of the per-variable "Is Literal" checkbox's state
# (coollabsio/coolify#8976, closed as duplicate; #1919, closed "not
# planned" by Coolify's own maintainers). If you can't get "Is Literal" to
# fix a broken value - or Coolify 4.3.9+ won't let you toggle it at all -
# that's this bug, not a misconfiguration on your end. The real fix is to
# avoid embedding " in the value in the first place:
#   - BRANDING_TITLE_HTML: use unquoted HTML attribute syntax (see the
#     example below) instead of style="...". HTML5 permits an unquoted
#     attribute value as long as it has no spaces, ", ', `, =, <, or >,
#     which color:var(--brand-color) satisfies - it renders identically,
#     confirmed by direct comparison in a browser.
#   - BRANDING_COLOR: a bare hex value (#2563eb) never contains a " to
#     begin with, so it isn't affected by this bug either way.
# Other platforms' env-var UIs may have their own equivalent toggle/quirk -
# check for one if branding doesn't apply there.

# URL to a logo image - local (/branding/logo.png, served from public/) or
# remote (https://...). Shown at a small size in the app header and a larger
# size on the login page. Leave unset to show no logo.
BRANDING_LOGO_URL=

# Optional destination opened when the logo is clicked - e.g. your own
# marketing site. Only takes effect if BRANDING_LOGO_URL is also set (a
# link with no logo to click is meaningless). Leave unset for a
# non-clickable logo, the current default behavior.
BRANDING_LOGO_LINK_URL=

# Contact address shown as a "Contact support" link in the console's own
# footer (login page and the authenticated app shell) - there was
# previously no way for a tenant to reach the operator at all. A plain
# email address; rendered as a mailto: link. Leave unset to hide the
# link entirely rather than show a broken/fake one.
SUPPORT_EMAIL=

# HTML (or plain text - both render fine through the same path) shown as the
# app title on the login page only - the in-app header (AppShellClient.tsx)
# shows just the logo, not this. Defaults to "License Console" if unset.
# Operator-controlled config, rendered as raw markup -
# never source this from user input. If your logo has a fixed brand color,
# reference it with var(--brand-color) instead of hardcoding a hex here, e.g.:
#   <span style=color:var(--brand-color)>Acme</span> License Console
# That keeps the title's accent and the primary button (BRANDING_COLOR,
# below) the same color automatically, instead of typing the same hex twice
# and having them drift apart. Written with unquoted attribute syntax
# (style=... not style="...") on purpose - see the Coolify gotcha note
# above; it renders identically but has no " characters for Coolify to
# mangle.
BRANDING_TITLE_HTML=

# A single accent color (any valid CSS color, e.g. a hex matching your logo)
# applied to the primary button and available to BRANDING_TITLE_HTML via
# var(--brand-color) - see the note above. Defaults to Mantine's standard
# blue (#228be6) if unset.
#
# If you're editing a .env FILE directly, quote hex values so dotenv doesn't
# parse the unquoted # as a comment, e.g. BRANDING_COLOR="#2563eb". If
# you're instead pasting this into a platform's env-var UI (Coolify, Docker,
# etc.), do NOT include the quotes - those UIs take the field value
# literally with no shell/dotenv-style stripping, so the quote characters
# would become part of the color itself and break rendering (confirmed:
# turns the primary button transparent). Enter #2563eb there, no quotes.
BRANDING_COLOR=

# Copyright holder name shown in a small "(c) <year> <holder>" line (year is
# computed automatically). Leave unset to hide the copyright line entirely.
BRANDING_COPYRIGHT_HOLDER=

# URL to a favicon image (local /favicon.png served from public/, or a
# remote https://... URL - same "no CORS issue, no next.config.js changes"
# reasoning as BRANDING_LOGO_URL applies here too). Leave unset to fall back
# to Next's own default favicon.
BRANDING_FAVICON_URL=

# --- Backend mode ---
#
# Both set -> connected to a real casazium/license server. Both left unset
# -> standalone mode: an in-memory mock with seeded demo data, no real
# backend required, for evaluating the console's look and feel on its own.
# Setting only one is almost certainly a mistake (e.g. a typo'd variable
# name) and fails fast with a clear error rather than guessing which mode
# was meant - see lib/license-client.ts's getBackendMode().

# Base URL of the casazium/license server this console manages, including
# the /v1 prefix (e.g. https://license.example.com/v1).
LICENSE_API_URL=

# Admin bearer token for the license server (casazium/license ADMIN_API_KEY).
# Server-side only - never expose via NEXT_PUBLIC_*. Under MULTI_TENANT=true,
# also used server-to-server by /api/signup (SaaS-B1b) to provision each
# new tenant via POST /admin/tenants - the signing-up human never sees or
# holds this key themselves.
LICENSE_ADMIN_API_KEY=

# Bearer token this console's own scripts/notify-expiring.mjs (BETA_LAUNCH_STATUS.md
# §4, lifecycle email alerts) presents to casazium/license's
# GET /admin/expiring-licenses. Must match that server's own
# NOTIFICATIONS_EXTRACT_KEY value - independent env vars on independent
# services, same "keeping them in sync is a deployment choice, not
# something either app enforces" reasoning as REPORT_EXTRACT_KEY below.
# Only required to run that script; the app itself never reads this.
NOTIFICATIONS_EXTRACT_KEY=

# Required (set to "true") in production ONLY when LICENSE_API_URL and
# LICENSE_ADMIN_API_KEY above are both intentionally left unset - i.e. you
# are deploying this as a real, public standalone/demo instance rather than
# connecting to an actual license server. In production, both-unset without
# this flag is treated as a misconfiguration (an operator who meant to
# configure live mode but didn't) rather than silently falling back to
# demo data - see lib/license-client.ts's getBackendMode(). Not required in
# development - `npm run dev` with no .env at all still defaults to
# standalone mode with zero config.
LICENSE_STANDALONE_MODE=

# Bearer token gating GET /api/admin/report-extract only
# (SUPERADMIN_REPORTING_DESIGN.md §6) - a distinct credential from
# ADMIN_UI_PASSWORD and from every tenant session, on purpose: this route
# aggregates across every tenant's accounts, and nothing else in this app
# is allowed to. Unset means that one route always rejects; every other
# route is unaffected. Comma-separated values are all accepted, so
# rotation is add-new-then-remove-old rather than a coordinated swap.
# Must match casazium/license's own REPORT_EXTRACT_KEY value if you want
# scripts/tenant-report.js to query both with one credential - they're
# independent env vars on independent services, so keeping them in sync
# is a deployment choice, not something either app enforces. Generate
# with:
#   openssl rand -hex 16
REPORT_EXTRACT_KEY=

# Litestream continuous WAL replication (TASK_LITESTREAM_HA.md) - an
# optional, off-by-default backup layer alongside the existing daily
# snapshot pipeline (BACKUP_RETENTION_DAYS - see DEPLOYMENT.md's Backups
# section; not its own entry in this file, but a real env var read by
# scripts/backup-db.mjs and scripts/backup-and-push.sh, default 14),
# cutting realistic
# data-loss exposure on console.db from "up to a day" to "a few seconds."
# Mirrors casazium/license's own Litestream setup (see that repo's
# .env.example for the full mechanism notes); the one real difference is
# audience, not mechanism - console.db is only load-bearing on the
# SaaS-tier resource Casazium itself operates (every write path is gated
# behind MULTI_TENANT), so in practice only that resource will ever set
# this. Unset (every deployment except that one) means litestream is
# never invoked at all - scripts/start.sh's own on/off branch decides
# this before litestream is ever invoked, so this is a genuine
# zero-behavior-change default.
#
# Set LITESTREAM_REPLICA_BUCKET to enable. The replica destination's
# object-storage PATH is derived automatically at boot (the same
# saas/standalone branch scripts/backup-and-push.sh already uses for its
# own B2 destination) - there is no path variable to set here, and
# deliberately so: a hand-set path was found, in casazium/license, to
# silently destroy two unrelated databases' recovery data when they
# collided on the same path.
LITESTREAM_REPLICA_BUCKET=

# Required for every S3-compatible provider that ISN'T real AWS S3
# (Backblaze B2, Cloudflare R2, MinIO, etc.) - leaving either blank
# against a non-AWS provider makes the S3 client silently select
# AWS-specific addressing semantics, not a neutral default. Leave both
# blank only when LITESTREAM_REPLICA_BUCKET is a real AWS S3 bucket.
LITESTREAM_REPLICA_ENDPOINT=
LITESTREAM_REPLICA_REGION=

# Credentials for the replica destination above. IMPORTANT: if
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY are ALSO set in this
# container's environment for any other reason, they take precedence
# over these two and litestream silently uses them instead - do not set
# an unrelated AWS_* credential pair in a container that also has
# Litestream enabled unless it's deliberately meant for Litestream to
# use.
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=

# A misconfigured/unreachable replica destination (bad credentials,
# deleted bucket, unreachable endpoint) logs a loud warning at boot and
# on every failed sync attempt afterward, but never blocks the app from
# starting or serving traffic - this is a backup layer, not something
# this console depends on to run. See DEPLOYMENT.md's Litestream section
# for how to monitor whether it's actually replicating, since nothing
# else will surface a stuck replica.
