# Session signing secret (HMAC key for signed session cookies). Generate with:
#   openssl rand -base64 32
SESSION_SECRET=

# Shared admin password gating the console. See PROJECT_STATUS.md §3 for the
# planned migration path to per-user accounts.
ADMIN_UI_PASSWORD=

# Base URL of the casazium/license server this console manages, including the
# /v1 prefix (e.g. https://license.example.com/v1). Not yet used - no page is
# wired to the license server API yet.
LICENSE_API_URL=

# Admin bearer token for the license server (casazium/license ADMIN_API_KEY).
# Server-side only - never expose via NEXT_PUBLIC_*. Not yet used.
LICENSE_ADMIN_API_KEY=
